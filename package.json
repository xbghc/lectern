{
  "name": "lectern",
  "version": "0.3.20",
  "private": true,
  "description": "A browser extension and Android reading companion with focus tracking, AI translation, spaced repetition and optional device sync.",
  "type": "module",
  "scripts": {
    "ocr-check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ocr-check.ts",
    "providers:update": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/update-providers.ts",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build && npm run build:app",
    "build:app": "node build.mjs --app",
    "watch:app": "node build.mjs --app --watch",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck:storybook": "tsc --project tsconfig.storybook.json",
    "test:storybook": "node --test storybook/pages.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@fontsource/source-serif-4": "^5.3.0",
    "@storybook/html-vite": "10.6.0",
    "@types/chrome": "^0.0.268",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^25.0.1",
    "storybook": "10.6.0",
    "typescript": "^5.5.0",
    "vite": "6.4.3"
  }
}
