{
  "manifest_version": 3,
  "name": "Lectern \u2014 Reading Companion",
  "version": "0.1.0",
  "description": "Track reading progress, translate selected text with your own AI provider, and review vocabulary with spaced repetition.",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "sidePanel",
    "tabs",
    "offscreen",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "screenshot-translate": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Screenshot translation: select text in an image to translate"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Lectern"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
